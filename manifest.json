{
  "manifest_version": 3,
  "name": "职聘通·网申助手",
  "version": "3.1.0",
  "minimum_chrome_version": "110",
  "description": "网申自动填写：用文字描述你的资料，由DeepSeek结合网页上下文逐字核验后填写；未填上的字段会说明原因，并按失败原因自动修正一次。资料只保存在本机，调用模型时发送相关内容至DeepSeek。",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "exclude_matches": ["https://api.deepseek.com/*"],
    "js": ["floating.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "职聘通·网申助手"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
